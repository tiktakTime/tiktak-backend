model RolePermission {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id         String   @db.Uuid
  permission_id   String   @db.Uuid
  organization_id String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([organization_id, role_id, permission_id], map: "idx_role_permission_organization_role_permission_unique")
  @@index([organization_id], map: "idx_role_permission_organization_id")
  @@index([role_id], map: "idx_role_permission_role_id")
  @@index([permission_id], map: "idx_role_permission_permission_id")
  @@index([organization_id, role_id], map: "idx_role_permission_organization_role")
  @@index([organization_id, permission_id], map: "idx_role_permission_organization_permission")
  @@map("role_permission")
}
