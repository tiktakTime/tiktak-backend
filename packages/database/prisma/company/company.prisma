model Company {
  id                     String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String                     @db.Uuid
  country_id             String?                    @db.Uuid
  reference_id           String?                    @db.Uuid
  company_name           String?                    @db.VarChar(255)
  first_name             String?                    @db.VarChar(255)
  last_name              String?                    @db.VarChar(255)
  business_type          OrganizationBusinessType
  legal_form             OrganizationLegalForm?
  established_date       DateTime?                  @db.Date
  email                  String?                    @db.VarChar(255)
  phone_landline         String?                    @db.VarChar(15)
  phone_mobile           String?                    @db.VarChar(50)
  fax                    String?                    @db.VarChar(50)
  website                String?                    @db.VarChar(255)
  company_no             String?                    @db.VarChar(255)
  tax_id                 String?                    @db.VarChar(255)
  vat_id                 String?                    @db.VarChar(255)
  bin                    String?                    @db.VarChar(255)
  trade_license_no       String?                    @db.VarChar(255)
  commercial_register_no String?                    @db.VarChar(255)
  eori_number            String?                    @db.VarChar(255)
  register_court         String?                    @db.VarChar(255)
  account_holder         String?                    @db.VarChar(255)
  industry_category      String?                    @db.VarChar(255)
  image                  String?
  about                  String?
  status                 OrganizationStatus         @default(active)
  expired_date           DateTime?                  @db.Timestamptz(6)
  created_by_id          String?                    @db.Uuid
  updated_by_id          String?                    @db.Uuid
  deleted_by_id          String?                    @db.Uuid
  created_at             DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                   @default(now()) @db.Timestamptz(6)
  deleted_at             DateTime?                  @db.Timestamptz(6)

  @@unique([organization_id, company_name], map: "idx_company_organization_name_unique")
  @@index([organization_id], map: "idx_company_organization_id")
  @@index([status], map: "idx_company_status")
  @@index([country_id], map: "idx_company_country_id")
  @@index([reference_id], map: "idx_company_reference_id")
  @@map("company")
}
