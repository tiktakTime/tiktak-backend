model Person {
  id                          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id             String              @db.Uuid
  user_id                     String?             @db.Uuid
  role_id                     String?             @db.Uuid
  employee_id                 String?             @db.Uuid
  country_id                  String?             @db.Uuid
  nationality_id              String?             @db.Uuid
  first_name                  String              @db.VarChar(255)
  last_name                   String              @db.VarChar(255)
  email                       String?             @db.VarChar(255)
  gender                      UserGender          @default(none)
  birth_location              String?             @db.VarChar(255)
  birthdate                   DateTime?           @db.Date
  image                       String?
  phone_landline              String?             @db.VarChar(15)
  phone_mobile                String?             @db.VarChar(50)
  driver_license_no           String?             @db.VarChar(255)
  driver_license_type         String?             @db.VarChar(255)
  driver_license_organization String?             @db.VarChar(255)
  insurance_company           String?             @db.VarChar(255)
  insurance_no                String?             @db.VarChar(255)
  insurance_class             String?             @db.VarChar(255)
  tax_no                      String?             @db.VarChar(255)
  tax_id                      String?             @db.VarChar(255)
  tax_class                   String?             @db.VarChar(255)
  child_exempt_amount         String?             @db.VarChar(255)
  health_insurance            String?             @db.VarChar(255)
  social_health_no            String?             @db.VarChar(255)
  status                      OrganizationStatus  @default(inactive)
  expired_date                DateTime?           @db.Timestamptz(6)
  created_by_id               String?             @db.Uuid
  updated_by_id               String?             @db.Uuid
  deleted_by_id               String?             @db.Uuid
  created_at                  DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime            @default(now()) @db.Timestamptz(6)
  deleted_at                  DateTime?           @db.Timestamptz(6)

  @@unique([organization_id, employee_id], map: "idx_person_organization_employee_unique")
  @@unique([organization_id, user_id], map: "idx_person_organization_user_unique")
  @@unique([organization_id, email], map: "idx_person_organization_email_unique")
  @@index([organization_id], map: "idx_person_organization_id")
  @@index([organization_id, email], map: "idx_person_organization_email")
  @@index([organization_id, first_name, last_name], map: "idx_person_organization_name")
  @@index([organization_id, role_id], map: "idx_person_organization_role")
  @@map("person")
}
