model Address {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String?   @db.Uuid
  reference_id        String    @db.Uuid
  name                String    @db.VarChar(255)
  st_num              String?   @db.VarChar(50)
  st_name             String    @db.VarChar(255)
  neighbh             String?   @db.VarChar(255)
  city                String    @db.VarChar(255)
  state               String?   @db.VarChar(255)
  zip                 String?   @db.VarChar(20)
  cnt_name            String?   @db.VarChar(255)
  is_default          Boolean   @default(false)
  address_description String?
  place_id            String?   @db.VarChar(255)
  lat                 Decimal?  @db.Decimal(9, 6)
  lng                 Decimal?  @db.Decimal(9, 6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime? @db.Timestamptz(6)

  @@index([organization_id], map: "idx_address_organization_id")
  @@index([reference_id], map: "idx_address_reference_id")
  @@index([city], map: "idx_address_city")
  @@index([cnt_name], map: "idx_address_country")
  @@index([place_id], map: "idx_address_place_id")
  @@map("address")
}
