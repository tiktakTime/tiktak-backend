model BankAccount {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String?   @db.Uuid
  reference_id    String    @db.Uuid
  owner_name      String    @db.VarChar(255)
  is_owner        Boolean
  is_default      Boolean   @default(false)
  bank_name       String    @db.VarChar(255)
  bank_country    String?   @db.VarChar(2)
  currency        String?   @db.VarChar(3)
  iban            String?   @db.VarChar(34)
  swift_code      String?   @db.VarChar(11)
  account_number  String?   @db.VarChar(50)
  routing_number  String?   @db.VarChar(20)
  description     String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)

  @@index([organization_id], map: "idx_bank_account_organization_id")
  @@index([reference_id], map: "idx_bank_account_reference_id")
  @@index([iban], map: "idx_bank_account_iban")
  @@index([account_number], map: "idx_bank_account_account_number")
  @@map("bank_account")
}
