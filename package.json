{
  "name": "tiktak-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "dotenv -e .env.local -- tsx watch index.ts",
    "start": "dotenv -e .env -- sh -c 'prisma migrate deploy && tsx index.ts'",
    "check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,md,json}\"",
    "lint": "eslint .",
    "arch": "depcruise . --validate --config .dependency-cruiser.cjs",
    "arch:graph": "depcruise . --include-only \"^(apps|core|platform|modules|middlewares|server|index)\" --output-type archi --config .dependency-cruiser.cjs | dot -Tsvg > docs/architecture-graph.svg",
    "dead": "knip",
    "test": "vitest run",
    "verify": "pnpm format:check && pnpm check && pnpm lint && pnpm arch && pnpm dead && pnpm test",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down",
    "local:reset": "docker compose down -v && docker compose up -d",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:generate:ci": "prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env -- prisma migrate deploy",
    "db:status": "dotenv -e .env.local -- prisma migrate status",
    "db:studio": "dotenv -e .env.local -- prisma studio"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.1129.0",
    "@hono/node-server": "^1.19.9",
    "@hono/zod-openapi": "^1.4.0",
    "@scalar/hono-api-reference": "^0.9.48",
    "@t3-oss/env-core": "^0.13.11",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "file-type": "^22.0.2",
    "heic-convert": "^2.1.0",
    "hono": "^4.8.3",
    "ioredis": "5.10.1",
    "is-svg": "^6.1.0",
    "jose": "^6.2.12",
    "kysely": "^0.28.17",
    "pg": "^8.13.3",
    "sharp": "^0.35.4",
    "socket.io": "4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.7.0",
    "@types/pg": "^8.20.0",
    "dependency-cruiser": "^18.3.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "knip": "^6.36.0",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "prisma-kysely": "^3.1.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
