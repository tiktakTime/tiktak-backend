    "/organization/employee/search": {
      "get": {
        "operationId": "GetOrganizationEmployeeSearch",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "exclusiveMinimum": true,
              "minimum": 0,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "exclusiveMinimum": true,
              "maximum": 400,
              "minimum": 0,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "minLength": 1,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "enum": [
                "ASC",
                "DESC",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "compact",
            "required": false,
            "schema": {
              "nullable": true,
              "type": "boolean",
            },
          },
          {
            "in": "query",
            "name": "pure",
            "required": false,
            "schema": {
              "nullable": true,
              "type": "boolean",
            },
          },
          {
            "in": "query",
            "name": "organization_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "person_status",
            "required": false,
            "schema": {
              "enum": [
                "active",
                "inactive",
                "blocked",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "role_id",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "company_id",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "experience_types",
            "required": false,
            "schema": {
              "items": {
                "enum": [
                  "entry",
                  "exit",
                  "promotion",
                  "demotion",
                  "leave",
                  "contract_change",
                  "transfer",
                  "suspension",
                  "training",
                ],
                "type": "string",
              },
              "type": "array",
            },
          },
          {
            "in": "query",
            "name": "exclude_experience_types",
            "required": false,
            "schema": {
              "items": {
                "enum": [
                  "entry",
                  "exit",
                  "promotion",
                  "demotion",
                  "leave",
                  "contract_change",
                  "transfer",
                  "suspension",
                  "training",
                ],
                "type": "string",
              },
              "type": "array",
            },
          },
          {
            "in": "query",
            "name": "start_date",
            "required": false,
            "schema": {
              "format": "date-time",
              "nullable": true,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "end_date",
            "required": false,
            "schema": {
              "format": "date-time",
              "nullable": true,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeePage",
                },
              },
            },
