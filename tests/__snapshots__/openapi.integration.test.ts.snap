    "/auth/logout": {
      "post": {
        "operationId": "PostAuthLogout",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "type": "string",
                    },
                    "data": {
                      "nullable": true,
                    },
                    "errors": {
                      "items": {
                        "$ref": "#/components/schemas/ApiFieldError",
                      },
                      "type": "array",
                    },
                    "message": {
                      "nullable": true,
                      "type": "string",
                    },
                    "meta": {
                      "properties": {
                        "detail": {
                          "type": "string",
                        },
                        "trace_id": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "trace_id",
                      ],
                      "type": "object",
                    },
                    "status": {
                      "enum": [
                        "success",
                        "info",
                        "warning",
                        "error",
                      ],
                      "type": "string",
                    },
                    "title": {
                      "nullable": true,
                      "type": "string",
                    },
                  },
                  "required": [
                    "status",
                    "code",
                    "title",
                    "message",
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Logged out",
