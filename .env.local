NODE_ENV=development
PORT=3001
WEB_BASE_URL=https://localhost:3000
API_BASE_PATH=/api-test


# Local docker compose (see docker-compose.yml)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASS=dev
PG_DB_LIVE=tiktak-v2
PG_DB_TEST=tiktak-test-v2

DATABASE_URL_LIVE=postgresql://postgres:dev@localhost:5432/tiktak-v2
DATABASE_URL_TEST=postgresql://postgres:dev@localhost:5432/tiktak-test-v2
DIRECT_URL_LIVE=postgresql://postgres:dev@localhost:5432/tiktak-v2
DIRECT_URL_TEST=postgresql://postgres:dev@localhost:5432/tiktak-test-v2

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=assets
S3_URL=http://localhost:9000/assets/
JWT_SECRET=dev-only-change-me-jwt-secret
