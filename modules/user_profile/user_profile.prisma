/// Soğuk demografi (1:1). Hot isim/avatar/locale `user` tablosunda.
model UserProfile {
  user_id            String     @id @db.Uuid
  country_id         String?    @db.Uuid
  nationality_id     String?    @db.Uuid
  gender             UserGender @default(none)
  birth_location     String?    @db.VarChar(255)
  birthdate          DateTime?  @db.Date
  phone_landline     String?    @db.VarChar(15)
  phone_number       String?    @unique(map: "idx_user_profile_phone_number_unique") @db.VarChar(50)
  phone_verified_at  DateTime?  @db.Timestamptz(6)
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  updated_at         DateTime   @default(now()) @db.Timestamptz(6)

  @@index([country_id], map: "idx_user_profile_country_id")
  @@index([nationality_id], map: "idx_user_profile_nationality_id")
  @@map("user_profile")
}
