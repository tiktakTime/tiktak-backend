/// Platform kimliği — hot fields (session / mail / UI snapshot).
/// Demografi → user_profile; giriş yolları → user_identity; cihazlar → user_device.
model User {
  id                          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  system_role_id              String?    @db.Uuid
  /// Birincil iletişim; OAuth-only’de null olabilir. Doluysa unique.
  email                       String?    @unique(map: "idx_user_email_unique") @db.VarChar(255)
  status                      UserStatus @default(active)
  first_name                  String     @default("") @db.VarChar(255)
  last_name                   String     @default("") @db.VarChar(255)
  display_name                String?    @db.VarChar(255)
  picture                     String?
  locale                      String?    @db.VarChar(35)
  timezone                    String?    @db.VarChar(64)
  expires_at                  DateTime?  @db.Timestamptz(6)
  email_verified_at           DateTime?  @db.Timestamptz(6)
  two_factor_enabled_at       DateTime?  @db.Timestamptz(6)
  recovery_email              String?    @unique(map: "idx_user_recovery_email_unique") @db.VarChar(255)
  recovery_email_verified_at  DateTime?  @db.Timestamptz(6)
  last_login_at               DateTime?  @db.Timestamptz(6)
  created_at                  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime   @default(now()) @db.Timestamptz(6)
  deleted_at                  DateTime?  @db.Timestamptz(6)

  @@index([status], map: "idx_user_status")
  @@index([system_role_id], map: "idx_user_system_role_id")
  @@map("user")
}
