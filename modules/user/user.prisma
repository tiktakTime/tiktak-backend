/// Platform hesabı. Giriş yöntemi, cihaz ve detay ayrı modellerde. Oturum cihaz satırındadır.
model User {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  system_role_id String? @db.Uuid

  first_name   String  @db.VarChar(255)
  last_name    String  @db.VarChar(255)
  full_name    String  @db.VarChar(511)
  email        String  @unique(map: "idx_user_email_unique") @db.VarChar(255)
  image        String? @db.Text
  phone_mobile String? @unique(map: "idx_user_phone_mobile_unique") @db.VarChar(50)

  recovery_email             String? @unique(map: "idx_user_recovery_email_unique") @db.VarChar(255)
  is_recovery_email_verified Boolean @default(false)
  is_email_verified          Boolean @default(false)
  is_phone_verified          Boolean @default(false)
  is_two_factor_enabled      Boolean @default(false)

  status        UserStatus @default(active)
  expired_date  DateTime?  @db.Timestamptz(6)
  last_login_at DateTime?  @db.Timestamptz(6)

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  identities    UserIdentity[]
  devices       UserDevice[]
  verifications UserVerification[]
  detail        UserDetail?
  invites       Invite[]

  @@index([status], map: "idx_user_status")
  @@index([system_role_id], map: "idx_user_system_role_id")
  @@map("user")
}
