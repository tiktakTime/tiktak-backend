/// Kurulum başına bir cihaz. Açık oturum bu satırdaki token'dır.
model UserDevice {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  installation_id String         @db.VarChar(255)
  platform        DevicePlatform
  name            String?        @db.VarChar(255)
  model           String?        @db.VarChar(255)
  os_version      String?        @db.VarChar(50)
  app_version     String?        @db.VarChar(50)
  locale          String?        @db.VarChar(20)
  timezone        String?        @db.VarChar(64)

  push_token    String?       @unique(map: "idx_user_device_push_token_unique") @db.Text
  push_provider PushProvider?

  token_hash String?   @unique(map: "idx_user_device_token_unique") @db.VarChar(255)
  expires_at DateTime? @db.Timestamptz(6)

  last_seen_at DateTime? @db.Timestamptz(6)
  last_ip      String?   @db.Inet
  revoked_at   DateTime? @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([user_id, installation_id], map: "idx_user_device_installation_unique")
  @@map("user_device")
}
