/// Tek kullanımlık doğrulama kodu. Kodun kendisi tutulmaz, hash tutulur.
model UserVerification {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  type          VerificationType
  target        String           @db.VarChar(255)
  token_hash    String           @unique(map: "idx_user_verification_token_unique") @db.VarChar(255)
  attempt_count Int              @default(0)

  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, type], map: "idx_user_verification_user_type")
  @@map("user_verification")
}
