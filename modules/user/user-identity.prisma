/// Giriş yöntemi. Google ve Apple `sub` değeri `subject` kolonundadır. Şifre yalnızca email satırında durur.
model UserIdentity {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  provider       UserAuthProvider
  subject        String           @db.VarChar(255)
  email          String?          @db.VarChar(255)
  email_verified Boolean          @default(false)
  private_email  Boolean          @default(false)

  password                String?   @db.VarChar(255)
  last_password_change_at DateTime? @db.Timestamptz(6)
  refresh_token           String?   @db.Text

  last_used_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([provider, subject], map: "idx_user_identity_provider_unique")
  @@unique([user_id, provider], map: "idx_user_identity_user_provider_unique")
  @@map("user_identity")
}
