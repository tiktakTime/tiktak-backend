/// Giriş yöntemleri: password | google | apple. Kalıcı IdP anahtarı = provider_subject (sub).
model UserIdentity {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String       @db.Uuid
  provider             AuthProvider
  /// Google/Apple `sub`; password için `"local"`.
  provider_subject     String       @db.VarChar(255)
  provider_email       String?      @db.VarChar(255)
  password_hash        String?      @db.VarChar(255)
  password_changed_at  DateTime?    @db.Timestamptz(6)
  linked_at            DateTime     @default(now()) @db.Timestamptz(6)
  last_used_at         DateTime?    @db.Timestamptz(6)
  created_at           DateTime     @default(now()) @db.Timestamptz(6)
  updated_at           DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([provider, provider_subject], map: "idx_user_identity_provider_subject_unique")
  @@index([user_id], map: "idx_user_identity_user_id")
  @@map("user_identity")
}
