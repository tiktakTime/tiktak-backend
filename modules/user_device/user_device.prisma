/// Cihaz başına FCM push kaydı (1 user → N device). Redis: user_devices:{user_id}.
model UserDevice {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String         @db.Uuid
  platform     DevicePlatform
  /// FCM registration token; globally unique.
  push_token   String?        @unique(map: "idx_user_device_push_token_unique") @db.VarChar(512)
  /// Client install / device id (token rotation upsert anahtarı alternatif).
  device_id    String?        @db.VarChar(255)
  app_version  String?        @db.VarChar(50)
  is_active    Boolean        @default(true)
  last_seen_at DateTime       @default(now()) @db.Timestamptz(6)
  revoked_at   DateTime?      @db.Timestamptz(6)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)

  @@index([user_id], map: "idx_user_device_user_id")
  @@index([user_id, is_active], map: "idx_user_device_user_active")
  @@map("user_device")
}
