model Employee {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  person_id       String    @db.Uuid
  experience_id   String?   @db.Uuid
  exit_date       DateTime? @db.Timestamptz(6)
  employee_no     Int?
  created_by_id   String?   @db.Uuid
  updated_by_id   String?   @db.Uuid
  deleted_by_id   String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)

  @@unique([organization_id, person_id], map: "idx_employee_organization_person_unique")
  @@index([organization_id], map: "idx_employee_organization_id")
  @@index([deleted_at], map: "idx_employee_deleted_at")
  @@index([person_id], map: "idx_employee_person_id")
  @@index([experience_id], map: "idx_employee_experience_id")
  @@index([organization_id, exit_date], map: "idx_employee_org_exit_date")
  @@map("employee")
}
