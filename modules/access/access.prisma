model Access {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  user_id         String?      @db.Uuid
  person_id       String?      @db.Uuid
  role_id         String?      @db.Uuid
  status          AccessStatus @default(active)
  expired_date    DateTime?    @db.Timestamptz(6)
  description     String?
  created_by_id   String?      @db.Uuid
  updated_by_id   String?      @db.Uuid
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @db.Timestamptz(6)

  @@index([organization_id], map: "idx_access_organization_id")
  @@index([user_id], map: "idx_access_user_id")
  @@index([person_id], map: "idx_access_person_id")
  @@index([status], map: "idx_access_status")
  @@index([role_id], map: "idx_access_role_id")
  @@map("access")
}
