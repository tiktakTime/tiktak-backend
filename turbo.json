{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "PG_HOST",
    "PG_PORT",
    "PG_USER",
    "PG_PASS",
    "PG_DB_LIVE",
    "PG_DB_TEST",
    "SKIP_ENV_VALIDATION"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "db:ping": {
      "cache": false
    }
  }
}
