{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_URL_LIVE",
    "DATABASE_URL_TEST",
    "DIRECT_URL",
    "DIRECT_URL_LIVE",
    "DIRECT_URL_TEST",
    "PORT",
    "API_BASE_PATH",
    "REDIS_URL",
    "FIREBASE_PROJECT_ID",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_BUCKET_NAME",
    "RESEND_API_KEY",
    "SKIP_ENV_VALIDATION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "start": {
      "dependsOn": ["^start"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "lint": {
      "env": ["NODE_ENV"],
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "env": ["NODE_ENV"],
      "dependsOn": ["^lint:fix"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "dependsOn": ["^db:generate"]
    },
    "db:migrate": {
      "dependsOn": ["^db:migrate"]
    },
    "openapi:generate": {
      "outputs": ["openapi.json"]
    }
  }
}
