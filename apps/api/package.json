{
  "name": "api",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "check": "tsc --noEmit",
    "package-versions:check": "pnpm dlx npm-check-updates",
    "package-versions:update": "pnpm dlx npm-check-updates -u && pnpm install",
    "openapi:generate": "SKIP_ENV_VALIDATION=true tsx scripts/generate-openapi.ts > openapi.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@hono/node-server": "^1.19.9",
    "@hono/zod-openapi": "^1.4.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@scalar/hono-api-reference": "^0.9.48",
    "@tiktak/auth": "workspace:*",
    "@tiktak/cache": "workspace:*",
    "@tiktak/constants": "workspace:*",
    "@tiktak/core": "workspace:*",
    "@tiktak/database": "workspace:*",
    "@tiktak/domains": "workspace:*",
    "@tiktak/env": "workspace:*",
    "@tiktak/middlewares": "workspace:*",
    "@tiktak/queue": "workspace:*",
    "@tiktak/socket": "workspace:*",
    "@tiktak/storage": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.78.1",
    "clean-stack": "^6.0.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^12.0.3",
    "file-type": "^22.0.1",
    "hono": "^4.8.3",
    "hono-pino": "^0.8.0",
    "ioredis": "5.10.1",
    "is-svg": "^6.1.0",
    "jose": "^6.2.3",
    "kysely": "^0.28.17",
    "pg": "^8.13.3",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "stoker": "^2.0.1",
    "uuid": "^13.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/sharp": "^0.32.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
